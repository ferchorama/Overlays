      "lon": -104.22884,
      "enabled": true
    }
  ],
  "units": {
    "system": "imperial",
    "temperature": "fahrenheit",
    "wind": "mph",
    "locale": "en-US",
    "clock24": false
  },
  "data": {
    "refreshMinutes": 10,
    "timeoutMs": 9000,
    "retryOnFailSeconds": 60,
    "showStaleAfterMinutes": 30,
    "forecastDays": 1,
    "useCacheOnFailure": true,
    "cacheKey": "wx-cache-v2"
  },
  "googleFonts": [
    "Figtree:wght@400;500;600;700"
  ],
  "iconColors": {
    "sun": "#ff9500",
    "moon": "#4f5fe8",
    "cloud": "#ffffff",
    "cloudDark": "#6fa8e0",
    "rain": "#0a5fd0",
    "snow": "#ffffff",
    "bolt": "#ffb300",
    "fog": "#4f93c9"
  },
  "animation": {
    "autoPlay": true,
    "autoPlayDelay": 0.4,
    "headerDuration": 0.9,
    "headerEase": "power3.out",
    "cardDuration": 1.8,
    "cardEase": "power3.out",
    "cardStagger": 0.5,
    "cardStart": 0.55,
    "cardFrom": "bottom",
    "cardDistance": 150,
    "fadeRows": true,
    "ambient": true,
    "tweenValues": true,
    "tweenDuration": 1.4,
    "loopPreview": false,
    "loopHoldIn": 6,
    "loopHoldOut": 2
  },
  "sync": {
    "serverConfigUrl": "config.json",
    "pollMs": 2000,
    "stateUrl": "api/state",
    "statePollMs": 700
  }
